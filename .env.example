# Aegis runs in a non-persistent demo mode when these are omitted.
# Connect an Upstash Redis integration in Vercel for durable workspace state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connect a Vercel Blob store for durable uploaded source files.
BLOB_READ_WRITE_TOKEN=

# Keep true for the public capstone demo. Set false only after adding authentication.
AEGIS_DEMO_MODE=true
